NODE_ENV=development
POSTGRES_DB=selecao_posgrad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/selecao_posgrad?schema=public
FRONTEND_URL=http://localhost:3000
NEXT_SERVER_API_URL=http://backend:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=change-me-in-real-environments
UPLOADS_DIR=storage/uploads
LOG_LEVEL=info
ENABLE_SWAGGER_UI=true
AUTH_CACHE_TTL_MS=30000
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NEXT_PUBLIC_SHOW_DEV_TOOLS=true
