{
  "name": "sistema-selecao-posgrad",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "test:e2e:ui": "npm run test:e2e -w frontend",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "docker:dev:up": "docker compose -f docker-compose-dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose-dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose-dev.yml logs -f",
    "docker:prod:up": "docker compose -f docker-compose.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.yml logs -f"
  }
}
