generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATO
  AVALIADOR
  ADMIN
}

enum StatusConta {
  CRIADA
  ATIVA
  BLOQUEADA
}

enum CursoNivel {
  MESTRADO
  DOUTORADO
}

enum StatusEdital {
  RASCUNHO
  PUBLICADO
  EM_ANDAMENTO
  ENCERRADO
  CANCELADO
}

enum TipoCronogramaEdital {
  PEDIDO_ISENCAO
  RECURSO_ISENCAO
  INSCRICAO
  HOMOLOGACAO_PRELIMINAR
  RECURSO_HOMOLOGACAO
  HOMOLOGACAO_FINAL
  ETAPA_1
  RECURSO_ETAPA_1
  ETAPA_2
  RECURSO_ETAPA_2
  CLASSIFICACAO_PRELIMINAR
  RECURSO_CLASSIFICACAO
  RECURSO_HETEROIDENTIFICACAO
  CLASSIFICACAO_FINAL
  PUBLICACAO
  MATRICULA
}

enum ModalidadeConcorrencia {
  AMPLA_CONCORRENCIA
  ACOES_AFIRMATIVAS
  PCD
}

enum StatusConfirmacaoReserva {
  NAO_SE_APLICA
  PENDENTE
  CONFIRMADA
  NAO_CONFIRMADA
  AUSENTE
}

enum ModalidadeEtapa1 {
  REDACAO
  PRE_PROJETO
}

enum DesempateClassificacao {
  ETAPA1_ETAPA2_IDADE
  ETAPA1_IDADE
}

enum StatusParticipacaoEdital {
  ATIVA
  ENCERRADA
  CANCELADA
}

enum StatusPagamentoInscricao {
  NAO_APLICAVEL
  PENDENTE
  PAGO
  DISPENSADO
  INVALIDADO
}

enum StatusInscricao {
  RASCUNHO
  SUBMETIDA
  EM_ANALISE_DOCUMENTAL
  HOMOLOGADA_PRELIMINAR
  NAO_HOMOLOGADA_PRELIMINAR
  HOMOLOGADA_FINAL
  NAO_HOMOLOGADA_FINAL
  APTA_ETAPA_1
  ELIMINADA_ETAPA_1
  APTA_ETAPA_2
  CLASSIFICACAO_PRELIMINAR
  AGUARDANDO_HETEROIDENTIFICACAO
  CLASSIFICACAO_FINAL
  APROVADA
  LISTA_DE_ESPERA
  ELIMINADA
  MATRICULA_PENDENTE
  MATRICULADA
}

enum TipoDocumentoInscricao {
  DOCUMENTO_IDENTIFICACAO
  RNE_PASSAPORTE
  CPF
  DIPLOMA
  HISTORICO
  CURRICULO
  PRE_PROJETO
  COMPROVANTE_PAGAMENTO
  ANEXO_IV
  ANEXO_V
  LAUDO_PCD
  ANEXO_VIII_AUTODECLARACAO
  COMPROVANTE_ETNICO
  COMPROVANTE_AFFIRMATIVA
  OUTRO
}

enum StatusDocumentoInscricao {
  PENDENTE
  ENVIADO
  VALIDADO
  INVALIDADO
}

enum StatusIsencao {
  NAO_SOLICITADA
  SOLICITADA
  EM_ANALISE
  DEFERIDA_PRELIMINAR
  INDEFERIDA_PRELIMINAR
  DEFERIDA_FINAL
  INDEFERIDA_FINAL
}

enum StatusRecurso {
  ABERTO
  EM_ANALISE
  DEFERIDO
  INDEFERIDO
  RESPONDIDO
}

enum FaseRecurso {
  ISENCAO
  HOMOLOGACAO
  ETAPA_1
  ETAPA_2
  CLASSIFICACAO
  POLITICAS_AFIRMATIVAS
}

enum FaseHomologacaoRecurso {
  PRELIMINAR
  FINAL
}

enum StatusAvaliacaoEtapa {
  PENDENTE
  EM_AVALIACAO
  PRELIMINAR_PUBLICADA
  FINAL_PUBLICADA
}

enum StatusClassificacaoFinal {
  PRELIMINAR
  FINAL
  APROVADO
  LISTA_DE_ESPERA
  ELIMINADO
}

enum TipoPublicacaoOficial {
  EDITAL
  RETIFICACAO
  ISENCAO_PRELIMINAR
  ISENCAO_FINAL
  HOMOLOGACAO_PRELIMINAR
  HOMOLOGACAO_FINAL
  RESULTADO_ETAPA_1
  RESULTADO_ETAPA_2
  POLITICAS_AFIRMATIVAS_PRELIMINAR
  POLITICAS_AFIRMATIVAS_FINAL
  CLASSIFICACAO_PRELIMINAR
  CLASSIFICACAO_FINAL
  COMUNICADO
}

enum TipoEtapaPoliticasAfirmativas {
  HETEROIDENTIFICACAO
  PCD
}

enum StatusOperacaoPoliticasAfirmativas {
  PENDENTE
  CONVOCADO
  DOCUMENTOS_ENCAMINHADOS
  RESULTADO_PRELIMINAR_REGISTRADO
  RESULTADO_FINAL_REGISTRADO
}

enum ResultadoPoliticasAfirmativas {
  PENDENTE
  CONFIRMADO
  NAO_CONFIRMADO
  AUSENTE
}

model Usuario {
  id                 String               @id @default(cuid())
  nomeCompleto       String
  email              String               @unique
  senhaHash          String
  cpf                String?              @unique
  telefone           String?
  dataNascimento     DateTime?
  emailVerificadoEm  DateTime?
  statusConta        StatusConta          @default(CRIADA)
  criadoEm           DateTime             @default(now())
  atualizadoEm       DateTime             @updatedAt
  perfis             UsuarioPerfil[]
  participacoes      ParticipacaoEdital[]
  editaisCriados     Edital[]             @relation("EditalCriadoPor")
  recursosCriados    Recurso[]            @relation("RecursoCriadoPor")
  publicacoesCriadas PublicacaoOficial[]  @relation("PublicacaoCriadaPor")
  escoposAvaliacao   AvaliadorEscopo[]
  auditoriasCriadas  AuditoriaEvento[]    @relation("AuditoriaCriadaPor")
  sessoesRefresh      SessaoRefresh[]
  avaliacoesEtapa1Banca AvaliacaoEtapa1Avaliador[] @relation("AvaliacaoEtapa1AvaliadorUsuario")
}

model SessaoRefresh {
  id           String    @id @default(cuid())
  usuarioId    String
  tokenHash    String    @unique
  emitidoEm    DateTime  @default(now())
  expiraEm     DateTime
  invalidadoEm DateTime?
  userAgent    String?
  ip           String?
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiraEm])
  @@index([invalidadoEm, expiraEm])
}

model UsuarioPerfil {
  id         String   @id @default(cuid())
  usuarioId  String
  role       Role
  criadoEm   DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, role])
}

model AvaliadorEscopo {
  id              String        @id @default(cuid())
  usuarioId        String
  editalId         String
  linhaPesquisaId  String?
  criadoEm         DateTime      @default(now())
  atualizadoEm     DateTime      @updatedAt
  usuario          Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  edital           Edital        @relation(fields: [editalId], references: [id], onDelete: Cascade)
  linhaPesquisa    LinhaPesquisa? @relation(fields: [linhaPesquisaId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, editalId, linhaPesquisaId])
  @@index([usuarioId, editalId])
}

model AuditoriaEvento {
  id             String   @id @default(cuid())
  entidade       String
  entidadeId     String?
  acao           String
  descricao      String?
  payload        Json?
  criadoPorId    String?
  criadoEm       DateTime @default(now())
  criadoPor      Usuario? @relation("AuditoriaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([entidade, entidadeId, criadoEm])
  @@index([criadoPorId, criadoEm])
}

model Edital {
  id                    String                 @id @default(cuid())
  numero                String
  titulo                String
  descricao             String?
  ano                   Int
  semestre              Int?
  cursoNivel            CursoNivel
  status                StatusEdital           @default(RASCUNHO)
  publicadoEm           DateTime?
  criadoPorId           String?
  criadoEm              DateTime               @default(now())
  atualizadoEm          DateTime               @updatedAt
  criadoPor             Usuario?               @relation("EditalCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  cronogramas           CronogramaEdital[]
  linhasPesquisa        LinhaPesquisa[]
  temasRedacao          TemaRedacaoEdital[]
  criteriosTitulacao    CriterioTitulacaoEdital[]
  escoposAvaliacao      AvaliadorEscopo[]
  participacoes         ParticipacaoEdital[]
  publicacoesOficiais   PublicacaoOficial[]
  avaliacoesEtapa1      AvaliacaoEtapa1[]
  avaliacoesEtapa2      AvaliacaoEtapa2[]
  recursos              Recurso[]
  classificacoesFinais  ClassificacaoFinal[]
  configuracaoProcesso  ConfiguracaoProcessoEdital?
  criteriosEtapa1       CriterioAvaliacaoEtapa1Edital[]
  gruposPesquisa        GrupoPesquisa[]
  avaliacoesEtapa1Banca AvaliacaoEtapa1Avaliador[]

  @@unique([numero, ano, cursoNivel])
}

model ConfiguracaoProcessoEdital {
  id                       String                 @id @default(cuid())
  editalId                 String                 @unique
  modalidadeEtapa1         ModalidadeEtapa1       @default(REDACAO)
  pesoEtapa1               Int                    @default(1)
  pesoEtapa2               Int                    @default(2)
  notaMinimaEtapa1         Decimal                @default(7) @db.Decimal(5, 2)
  desempate                DesempateClassificacao @default(ETAPA1_ETAPA2_IDADE)
  avaliadoresEtapa1        Int                    @default(1)
  exigeDiplomaGraduacao    Boolean                @default(true)
  exigeHistoricoGraduacao  Boolean                @default(true)
  exigeGrupoPesquisa       Boolean                @default(false)
  permiteCancelarSubmissao Boolean                @default(true)
  criadoEm                 DateTime               @default(now())
  atualizadoEm             DateTime               @updatedAt
  edital                   Edital                 @relation(fields: [editalId], references: [id], onDelete: Cascade)
}

model CriterioAvaliacaoEtapa1Edital {
  id           String   @id @default(cuid())
  editalId     String
  chaveInterna String
  label        String
  peso         Int
  notaMaxima   Decimal  @default(10) @db.Decimal(5, 2)
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  edital       Edital   @relation(fields: [editalId], references: [id], onDelete: Cascade)

  @@unique([editalId, chaveInterna])
  @@index([editalId, ativo, ordem])
}

model GrupoPesquisa {
  id           String      @id @default(cuid())
  editalId     String
  nome         String
  descricao    String?
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  edital       Edital      @relation(fields: [editalId], references: [id], onDelete: Cascade)
  inscricoes   Inscricao[]

  @@unique([editalId, nome])
  @@index([editalId, ativo])
}

model CronogramaEdital {
  id          String               @id @default(cuid())
  editalId    String
  tipo        TipoCronogramaEdital
  titulo      String
  descricao   String?
  inicioEm    DateTime
  fimEm       DateTime
  criadoEm    DateTime             @default(now())
  atualizadoEm DateTime            @updatedAt
  edital      Edital               @relation(fields: [editalId], references: [id], onDelete: Cascade)

  @@index([editalId, tipo])
}

model LinhaPesquisa {
  id                     String                @id @default(cuid())
  editalId               String
  nome                   String
  descricao              String?
  vagasAmplaConcorrencia Int                   @default(0)
  vagasAcoesAfirmativas  Int                   @default(0)
  vagasPcd               Int                   @default(0)
  criadoEm               DateTime              @default(now())
  atualizadoEm           DateTime              @updatedAt
  edital                 Edital                @relation(fields: [editalId], references: [id], onDelete: Cascade)
  inscricoes             Inscricao[]
  classificacoesFinais   ClassificacaoFinal[]
  escoposAvaliacao       AvaliadorEscopo[]

  @@unique([editalId, nome])
}

model TemaRedacaoEdital {
  id            String      @id @default(cuid())
  editalId      String
  titulo        String
  descricao     String?
  ordem         Int         @default(0)
  ativo         Boolean     @default(true)
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt
  edital        Edital      @relation(fields: [editalId], references: [id], onDelete: Cascade)
  inscricoes    Inscricao[]

  @@index([editalId, ativo, ordem])
}

model CriterioTitulacaoEdital {
  id                 String   @id @default(cuid())
  editalId           String
  chaveInterna       String
  numeroNormativo    String
  descricao          String
  fator              Decimal? @db.Decimal(8, 3)
  teto               Decimal? @db.Decimal(8, 2)
  unidade            String
  regraEspecial      String?
  metadados          Json?
  ordem              Int      @default(0)
  ativo              Boolean  @default(true)
  pacoteOrigemSlug   String?
  pacoteOrigemVersao String?
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt
  edital             Edital   @relation(fields: [editalId], references: [id], onDelete: Cascade)
  titulosInscricao   TituloInscricao[]

  @@unique([editalId, chaveInterna])
  @@index([editalId, ativo, ordem])
  @@index([editalId, numeroNormativo])
}

model ParticipacaoEdital {
  id                    String                  @id @default(cuid())
  usuarioId             String
  editalId              String
  status                StatusParticipacaoEdital @default(ATIVA)
  criadoEm              DateTime                @default(now())
  atualizadoEm          DateTime                @updatedAt
  usuario               Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  edital                Edital                  @relation(fields: [editalId], references: [id], onDelete: Cascade)
  inscricao             Inscricao?
  pedidoIsencao         PedidoIsencao?
  recursos              Recurso[]
  classificacaoFinal    ClassificacaoFinal?

  @@unique([usuarioId, editalId])
  @@index([editalId, status])
  @@index([usuarioId])
}

model PedidoIsencao {
  id                          String        @id @default(cuid())
  participacaoEditalId        String        @unique
  cursoNivel                  CursoNivel
  inscritoCadUnico            Boolean
  nis                         String?
  justificativa               String?
  comprovanteUrl              String?
  comprovanteNomeArquivo      String?
  status                      StatusIsencao @default(SOLICITADA)
  parecerPreliminar           String?
  parecerFinal                String?
  resultadoPreliminarEm       DateTime?
  resultadoFinalEm            DateTime?
  criadoEm                    DateTime      @default(now())
  atualizadoEm                DateTime      @updatedAt
  participacaoEdital          ParticipacaoEdital @relation(fields: [participacaoEditalId], references: [id], onDelete: Cascade)
}

model Inscricao {
  id                          String                   @id @default(cuid())
  participacaoEditalId        String                   @unique
  linhaPesquisaId             String?
  grupoPesquisaId             String?
  temaRedacaoEditalId         String?
  modalidadeConcorrencia      ModalidadeConcorrencia   @default(AMPLA_CONCORRENCIA)
  confirmacaoAcoesAfirmativas StatusConfirmacaoReserva @default(NAO_SE_APLICA)
  confirmacaoPcd              StatusConfirmacaoReserva @default(NAO_SE_APLICA)
  status                      StatusInscricao          @default(RASCUNHO)
  statusPagamento             StatusPagamentoInscricao @default(PENDENTE)
  temaRedacao                 String?
  resumoCurriculo             String?
  redacaoTexto                String?
  dadosFormulario             Json?
  anexoIvGeradoUrl            String?
  assinaturaImagemUrl         String?
  submissaoSnapshot           Json?
  versaoSubmissao             Int                      @default(0)
  pacoteDocumentalUrl         String?
  pacoteDocumentalNomeArquivo String?
  pacoteDocumentalMimeType    String?
  pacoteDocumentalTamanhoBytes Int?
  pacoteDocumentalSnapshot    Json?
  pacoteDocumentalVersaoSubmissao Int?
  pacoteDocumentalGeradoEm    DateTime?
  pacoteDocumentalGeradoPorId String?
  submetidaEm                 DateTime?
  canceladaSubmissaoEm        DateTime?
  criadoEm                    DateTime                 @default(now())
  atualizadoEm                DateTime                 @updatedAt
  participacaoEdital          ParticipacaoEdital       @relation(fields: [participacaoEditalId], references: [id], onDelete: Cascade)
  linhaPesquisa               LinhaPesquisa?           @relation(fields: [linhaPesquisaId], references: [id], onDelete: SetNull)
  grupoPesquisa               GrupoPesquisa?           @relation(fields: [grupoPesquisaId], references: [id], onDelete: SetNull)
  temaRedacaoEdital           TemaRedacaoEdital?       @relation(fields: [temaRedacaoEditalId], references: [id], onDelete: SetNull)
  documentos                  DocumentoInscricao[]
  titulos                     TituloInscricao[]
  homologacao                 HomologacaoInscricao?
  avaliacaoEtapa1             AvaliacaoEtapa1?
  avaliacaoEtapa2             AvaliacaoEtapa2?
  avaliadoresEtapa1           AvaliacaoEtapa1Avaliador[]
  etapasPoliticasAfirmativas  EtapaPoliticasAfirmativas[]
}

model DocumentoInscricao {
  id                    String                   @id @default(cuid())
  inscricaoId           String
  tipo                  TipoDocumentoInscricao
  nome                  String
  urlArquivo            String
  nomeArquivo           String
  mimeType              String?
  tamanhoBytes          Int?
  obrigatorio           Boolean                  @default(true)
  statusValidacao       StatusDocumentoInscricao @default(ENVIADO)
  observacaoValidacao   String?
  criadoEm              DateTime                 @default(now())
  atualizadoEm          DateTime                 @updatedAt
  inscricao             Inscricao                @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@index([inscricaoId, tipo])
}

model TituloInscricao {
  id                         String                   @id @default(cuid())
  inscricaoId                String
  criterioTitulacaoEditalId  String
  descricaoTitulo            String
  urlArquivo                 String
  nomeArquivo                String
  mimeType                   String?
  tamanhoBytes               Int?
  ordem                      Int                      @default(0)
  criadoEm                   DateTime                 @default(now())
  atualizadoEm               DateTime                 @updatedAt
  inscricao                  Inscricao                @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  criterioTitulacaoEdital    CriterioTitulacaoEdital  @relation(fields: [criterioTitulacaoEditalId], references: [id], onDelete: Restrict)

  @@index([inscricaoId, criterioTitulacaoEditalId])
  @@index([criterioTitulacaoEditalId])
}

model HomologacaoInscricao {
  id                    String         @id @default(cuid())
  inscricaoId           String         @unique
  statusPreliminar      StatusInscricao?
  motivosPreliminar     Json?
  parecerPreliminar     String?
  submissaoSnapshotPreliminar Json?
  versaoSubmissaoPreliminar   Int?
  publicadoPreliminarEm DateTime?
  statusFinal           StatusInscricao?
  motivosFinal          Json?
  parecerFinal          String?
  submissaoSnapshotFinal Json?
  versaoSubmissaoFinal   Int?
  publicadoFinalEm      DateTime?
  criadoEm              DateTime       @default(now())
  atualizadoEm          DateTime       @updatedAt
  inscricao             Inscricao      @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
}

model AvaliacaoEtapa1 {
  id                    String               @id @default(cuid())
  editalId              String
  inscricaoId           String               @unique
  tema                  String?
  textoSubmetido        String?
  nota                  Decimal?             @db.Decimal(6, 3)
  rubricaDetalhada      Json?
  usoIaComprovado       Boolean              @default(false)
  fundamentoUsoIa       String?
  espelhoCorrecao       String?
  espelhoSolicitadoEm   DateTime?
  espelhoLiberadoEm     DateTime?
  status                StatusAvaliacaoEtapa @default(PENDENTE)
  resultadoPreliminarEm DateTime?
  resultadoFinalEm      DateTime?
  criadoEm              DateTime             @default(now())
  atualizadoEm          DateTime             @updatedAt
  edital                Edital               @relation(fields: [editalId], references: [id], onDelete: Cascade)
  inscricao             Inscricao            @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@index([editalId, status])
}

model AvaliacaoEtapa1Avaliador {
  id                 String   @id @default(cuid())
  editalId           String
  inscricaoId        String
  avaliadorUsuarioId String
  nota               Decimal  @db.Decimal(6, 3)
  rubricaDetalhada   Json?
  espelhoCorrecao    String?
  observacoes        String?
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt
  edital             Edital   @relation(fields: [editalId], references: [id], onDelete: Cascade)
  inscricao          Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  avaliador          Usuario  @relation("AvaliacaoEtapa1AvaliadorUsuario", fields: [avaliadorUsuarioId], references: [id], onDelete: Restrict)

  @@unique([inscricaoId, avaliadorUsuarioId])
  @@index([editalId, avaliadorUsuarioId])
}

model AvaliacaoEtapa2 {
  id                    String               @id @default(cuid())
  editalId              String
  inscricaoId           String               @unique
  pontuacaoItens        Json?
  pontuacaoBruta        Decimal?             @db.Decimal(7, 2)
  notaNormalizada       Decimal?             @db.Decimal(5, 2)
  memoriaCalculo        Json?
  glosas                Json?
  espelhoCorrecao       String?
  espelhoSolicitadoEm   DateTime?
  espelhoLiberadoEm     DateTime?
  status                StatusAvaliacaoEtapa @default(PENDENTE)
  resultadoPreliminarEm DateTime?
  resultadoFinalEm      DateTime?
  criadoEm              DateTime             @default(now())
  atualizadoEm          DateTime             @updatedAt
  edital                Edital               @relation(fields: [editalId], references: [id], onDelete: Cascade)
  inscricao             Inscricao            @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@index([editalId, status])
}

model Recurso {
  id                     String         @id @default(cuid())
  editalId               String
  participacaoEditalId   String
  criadoPorId            String
  fase                   FaseRecurso
  faseHomologacaoReferencia FaseHomologacaoRecurso?
  tipoPoliticasAfirmativasReferencia TipoEtapaPoliticasAfirmativas?
  status                 StatusRecurso  @default(ABERTO)
  fundamentacao          String
  anexoUrl               String?
  decisao                String?
  impactoResultado       Boolean        @default(false)
  respondidoEm           DateTime?
  criadoEm               DateTime       @default(now())
  atualizadoEm           DateTime       @updatedAt
  edital                 Edital         @relation(fields: [editalId], references: [id], onDelete: Cascade)
  participacaoEdital     ParticipacaoEdital @relation(fields: [participacaoEditalId], references: [id], onDelete: Cascade)
  criadoPor              Usuario        @relation("RecursoCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([participacaoEditalId, fase, tipoPoliticasAfirmativasReferencia, status])
  @@index([editalId, fase, status])
  @@index([editalId, status])
}

model ClassificacaoFinal {
  id                    String                  @id @default(cuid())
  editalId              String
  participacaoEditalId  String                  @unique
  linhaPesquisaId       String?
  modalidadeConcorrencia ModalidadeConcorrencia @default(AMPLA_CONCORRENCIA)
  notaEtapa1            Decimal?                @db.Decimal(5, 2)
  notaEtapa2            Decimal?                @db.Decimal(5, 2)
  notaFinal             Decimal?                @db.Decimal(5, 2)
  posicaoGeral          Int?
  posicaoLinha          Int?
  status                StatusClassificacaoFinal @default(PRELIMINAR)
  publicadoPreliminarEm DateTime?
  publicadoFinalEm      DateTime?
  criadoEm              DateTime                @default(now())
  atualizadoEm          DateTime                @updatedAt
  edital                Edital                  @relation(fields: [editalId], references: [id], onDelete: Cascade)
  participacaoEdital    ParticipacaoEdital      @relation(fields: [participacaoEditalId], references: [id], onDelete: Cascade)
  linhaPesquisa         LinhaPesquisa?          @relation(fields: [linhaPesquisaId], references: [id], onDelete: SetNull)

  @@index([editalId, status])
  @@index([status, modalidadeConcorrencia])
}

model PublicacaoOficial {
  id                 String               @id @default(cuid())
  editalId           String
  criadoPorId        String?
  republicacaoDeId   String?
  tipo               TipoPublicacaoOficial
  titulo             String
  descricao          String?
  versao             Int                  @default(1)
  versaoFinal        Boolean              @default(false)
  arquivoUrl         String?
  dadosConsolidados  Json?
  publicadoEm        DateTime?
  criadoEm           DateTime             @default(now())
  atualizadoEm       DateTime             @updatedAt
  edital             Edital               @relation(fields: [editalId], references: [id], onDelete: Cascade)
  criadoPor          Usuario?             @relation("PublicacaoCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  republicacaoDe     PublicacaoOficial?   @relation("PublicacaoOficialRepublicacao", fields: [republicacaoDeId], references: [id], onDelete: SetNull)
  republicacoes      PublicacaoOficial[]  @relation("PublicacaoOficialRepublicacao")

  @@unique([editalId, tipo, versao])
  @@index([editalId, tipo, publicadoEm])
}

model EtapaPoliticasAfirmativas {
  id                             String                            @id @default(cuid())
  inscricaoId                    String
  tipo                           TipoEtapaPoliticasAfirmativas
  statusOperacao                 StatusOperacaoPoliticasAfirmativas @default(PENDENTE)
  convocadoEm                    DateTime?
  documentosEncaminhadosEm       DateTime?
  protocoloEncaminhamento        String?
  observacaoEncaminhamento       String?
  encaminhadoPorId               String?
  resultadoPreliminar            ResultadoPoliticasAfirmativas      @default(PENDENTE)
  parecerPreliminar              String?
  arquivoRetornoPreliminarUrl    String?
  resultadoPreliminarEm          DateTime?
  resultadoPreliminarRegistradoPorId String?
  resultadoFinal                 ResultadoPoliticasAfirmativas      @default(PENDENTE)
  parecerFinal                   String?
  arquivoRetornoFinalUrl         String?
  resultadoFinalEm               DateTime?
  resultadoFinalRegistradoPorId  String?
  criadoEm                       DateTime                          @default(now())
  atualizadoEm                   DateTime                          @updatedAt
  inscricao                      Inscricao                         @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@unique([inscricaoId, tipo])
  @@index([inscricaoId])
  @@index([tipo, statusOperacao])
}
